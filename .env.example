# Production database (Neon / Supabase Postgres free tier works).
# When empty, local dev uses an embedded PGlite file DB in .data/ instead.
DATABASE_URL=

# Admin login seeded via: bun scripts/seed-admin.ts
ADMIN_EMAIL=admin@spicenflavors.com
ADMIN_PASSWORD=change-this-to-something-long

# Monetization (proposal §07, blueprint §5): AdSense ad zones render automatically once set.
# Find it in AdSense dashboard → Account → Publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
VITE_ADSENSE_CLIENT=
# Ad-slot IDs per placement (AdSense dashboard → Ads → Ad units). Leave empty
# to keep the layout-reserving placeholders while reviewing UX.
VITE_ADSENSE_SLOT_ARTICLE=
VITE_ADSENSE_SLOT_FEED=
VITE_ADSENSE_SLOT_SIDEBAR=

# Content assist (blueprint §6): empty = built-in heuristics. Set a provider
# name once callLlm() in src/lib/ai/provider.ts is implemented with a key.
VITE_AI_PROVIDER=
